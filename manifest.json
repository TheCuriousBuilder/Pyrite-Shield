{
  "manifest_version": 3,
  "name": "Pyrite Shield",
  "version": "7.0.1",
  "version_name": "7.0.1",
  "author": "Pyrite Security Team",
  "description": "Ultimate ad blocker: ads, trackers, cryptominers, annoyances & anti-adblock. Safe on legitimate sites (ChatGPT, Google Accounts, banks, SaaS). Fast YouTube/Twitch skip.",
  "homepage_url": "https://github.com/pyrite-shield",
  "minimum_chrome_version": "96",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "idle",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation",
    "webRequest",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "privacy",
        "enabled": true,
        "path": "rules-privacy.json"
      },
      {
        "id": "anti_circumvention",
        "enabled": true,
        "path": "rules-anti-cv.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules-annoyances.json"
      },
      {
        "id": "cryptominers",
        "enabled": true,
        "path": "rules-cryptominers.json"
      },
      {
        "id": "social",
        "enabled": true,
        "path": "rules-social.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pyrite Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "facebook.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "twitch.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.einthusan.tv/*",
        "*://*.einthusan.com/*"
      ],
      "js": [
        "einthusan.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hulu.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.hotstar.com/*"
      ],
      "js": [
        "streaming.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "devtools_page": "devtools.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "icons/*",
        "adblock.css"
      ],
      "use_dynamic_url": true
    }
  ]
}
